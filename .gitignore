# ==============================================================================
# Secrets & credentials
# ==============================================================================
.env
.env.*
!.env.example
**/*.env

# Kubeconfigs fetched from the cluster (`make fetch-kubeconfig`)
kubeconfig*
*.kubeconfig
.kube/

# Keys and certificates
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*

# ==============================================================================
# Terraform
# ==============================================================================
.terraform/
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info
crash.log
crash.*.log

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Local overrides
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Plan output (terraform plan -out=...)
*.tfplan
tfplan
planout

# CLI configuration
.terraformrc
terraform.rc

# NOTE: .terraform.lock.hcl is intentionally committed

# ==============================================================================
# Ansible
# ==============================================================================
*.retry
.ansible/
ansible/fact_cache/
*.vault_pass
.vault_pass*
vault_password*

# ==============================================================================
# Python
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ==============================================================================
# Local installers (should not be in the repo)
# ==============================================================================
*.pkg
*.dmg

# ==============================================================================
# OS / editor
# ==============================================================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
# .vscode/ is shared (settings + snippets); ignore only personal files
.vscode/*.log
.vscode/launch.json

# Logs
*.log
